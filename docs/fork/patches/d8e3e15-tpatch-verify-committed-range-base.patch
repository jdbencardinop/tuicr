+// committedRangeUpperKinds are the `patch-generations.json` generation
+// `upper.kind` values written by `tpatch record` for the git-range
+// capture family (--auto, --from/--to, --commit-range — see
+// recordGenerationUpper in internal/cli/cobra.go). Any other kind
+// ("working-tree", "index") means the feature's canonical patch was
+// captured from an uncommitted working tree / index, never from a
+// committed commit range.
+func isCommittedRangeUpperKind(kind string) bool {
+	return kind == "commit" || kind == "range"
+}
+
+// resolveClosureShadowRoot picks the commit V7/V8's shared shadow
+// worktree should be rooted at (GH #3 — verify double-applies
+// committed-range captures).
+//
+// Baseline selection rules:
+//
+//   - No `patch-generations.json`, no generations, or the load itself
+//     is untrustworthy (malformed manifest) → use live HEAD, exactly
+//     the pre-fix behavior. Legacy features predating ADR-024 have no
+//     generation manifest at all and must keep replaying against HEAD.
+//   - Latest generation's `upper.kind` is NOT `commit`/`range` (i.e.
+//     working-tree, staged, or unstaged capture) → use live HEAD. These
+//     capture modes only ever produce an uncommitted apply-recipe /
+//     post-apply.patch pair; the feature's own changes are never part
+//     of repo history, so HEAD is exactly the right replay target and
+//     legitimately fails V7/V8 when upstream has drifted underneath.
+//   - Latest generation's `upper.kind` IS `commit`/`range` (committed-
+//     range family: --auto/--from+--to/--commit-range) → the target's
+//     own commits are already part of HEAD's history once landed, so
+//     replaying/checking against live HEAD double-applies them (the
+//     reproduction this fix targets). Use the recorded
+//     `status.apply.base_commit` instead — the record-time comment in
+//     internal/cli/cobra.go documents that for range mode this field IS
+//     the resolved pre-feature lower bound, not HEAD, so the canonical
+//     post-apply.patch is authored against exactly that commit.
+//   - The recorded base_commit is empty, fails to resolve, or is not an
+//     ancestor of (or equal to) live HEAD → fail explicitly. A missing
+//     or unreachable recorded base for a committed-range feature is a
+//     real correctness problem (rewritten history, corrupted status,
+//     etc.); silently falling back to HEAD would just reintroduce the
+//     double-apply bug or mask a genuinely broken feature record.
+func resolveClosureShadowRoot(s *store.Store, slug string, status store.FeatureStatus, head string) (string, error) {
+	manifest, err := store.LoadPatchGenerations(s, slug)
+	if err != nil || len(manifest.Generations) == 0 {
+		return head, nil
+	}
+	latest := manifest.Generations[len(manifest.Generations)-1]
+	if !isCommittedRangeUpperKind(latest.Upper.Kind) {
+		return head, nil
+	}
+
+	base := strings.TrimSpace(status.Apply.BaseCommit)
+	if base == "" {
+		base = strings.TrimSpace(latest.BaseCommit)
+	}
+	if base == "" {
+		return "", fmt.Errorf("committed-range capture (generation %d, upper.kind=%q) has no base_commit in status.apply or patch-generations.json", latest.Generation, latest.Upper.Kind)
+	}
+	resolved, rerr := gitutil.ResolveRef(s.Root, base)
+	if rerr != nil || resolved == "" {
+		return "", fmt.Errorf("recorded base_commit %q does not resolve in this repository: %v", base, rerr)
+	}
+	if resolved == head {
+		return resolved, nil
+	}
+	ok, aerr := gitutil.IsAncestor(s.Root, resolved, head)
+	if aerr != nil {
+		return "", fmt.Errorf("cannot verify recorded base_commit %q is reachable from HEAD %q: %v", base, head, aerr)
+	}
+	if !ok {
+		return "", fmt.Errorf("recorded base_commit %q is not reachable from current HEAD %q (history rewritten or status.json stale)", base, head)
+	}
+	return resolved, nil
+}
+
+// parentAlreadyInShadowBaseline reports whether a hard parent's own
+// committed-range landing commit is already part of shadowRoot's
+// history. When true, replaying the parent's recipe into the shadow
+// would double-apply changes that are already baked into shadowRoot
+// (the same class of bug resolveClosureShadowRoot fixes for the
+// target feature itself) — the caller should skip the parent replay,
+// mirroring the existing `upstream_merged` skip.
+//
+// Parents captured as working-tree/staged/unstaged, or with no
+// resolvable landing commit, always return false (never skipped) —
+// unchanged from pre-fix behavior; only an explicit committed-range
+// landing commit that is reachable from shadowRoot is trusted.
+func parentAlreadyInShadowBaseline(s *store.Store, parentSlug, shadowRoot string) (bool, error) {
+	manifest, err := store.LoadPatchGenerations(s, parentSlug)
+	if err != nil || len(manifest.Generations) == 0 {
+		return false, nil
+	}
+	latest := manifest.Generations[len(manifest.Generations)-1]
+	if !isCommittedRangeUpperKind(latest.Upper.Kind) {
+		return false, nil
+	}
+	landedAt := strings.TrimSpace(latest.Upper.Commit)
+	if landedAt == "" {
+		return false, nil
+	}
+	resolvedLanded, rerr := gitutil.ResolveRef(s.Root, landedAt)
+	if rerr != nil || resolvedLanded == "" {
+		// Parent's own recorded landing commit doesn't resolve — do
+		// not claim it's already baked in; fall through to the
+		// existing replay path, which will surface a clearer error
+		// if the parent recipe itself is broken.
+		return false, nil
+	}
+	resolvedRoot, rerr := gitutil.ResolveRef(s.Root, shadowRoot)
+	if rerr != nil || resolvedRoot == "" {
+		return false, fmt.Errorf("cannot resolve shadow root %q while checking parent %q baseline: %v", shadowRoot, parentSlug, rerr)
+	}
+	if resolvedLanded == resolvedRoot {
+		return true, nil
+	}
+	return gitutil.IsAncestor(s.Root, resolvedLanded, resolvedRoot)
+}
+
