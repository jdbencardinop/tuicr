+        _file_status: FileStatus,
+        _ref_commit: Option<&str>,
+    ) -> Result<u32> {
+        let content = if self.reloaded.load(Ordering::SeqCst) {
+            &self.reloaded_content
+        } else {
+            &self.initial_content
+        };
