+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct ClipboardEnvironment {
+    windows_interop: bool,
+    terminal_transport: bool,
+}
+
+impl ClipboardEnvironment {
+    fn current() -> Self {
+        Self {
+            windows_interop: env_var_is_nonempty("WSL_INTEROP"),
+            terminal_transport: should_prefer_osc52(),
+        }
+    }
+}
+
+fn env_var_is_nonempty(name: &str) -> bool {
+    std::env::var_os(name).is_some_and(|value| !value.is_empty())
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ClipboardRoute {
+    Pbcopy,
+    WindowsInterop,
+    Terminal,
+    LinuxSession,
+    System,
+}
+
+fn clipboard_routes(
+    target: ClipboardTarget,
+    environment: &ClipboardEnvironment,
+) -> Vec<ClipboardRoute> {
+    let mut routes = Vec::with_capacity(4);
+
+    match target {
+        ClipboardTarget::MacOs => routes.push(ClipboardRoute::Pbcopy),
+        ClipboardTarget::Linux if environment.windows_interop => {
+            routes.push(ClipboardRoute::WindowsInterop);
+        }
+        ClipboardTarget::Linux | ClipboardTarget::Windows | ClipboardTarget::Other => {}
+    }
+
+    if environment.terminal_transport {
+        routes.push(ClipboardRoute::Terminal);
+        return routes;
+    }
+
+    if target == ClipboardTarget::Linux {
+        routes.push(ClipboardRoute::LinuxSession);
+    }
+    routes.push(ClipboardRoute::System);
+    routes.push(ClipboardRoute::Terminal);
+    routes
+}
+
+fn execute_clipboard_routes<F>(
+    routes: &[ClipboardRoute],
+    text: &str,
+    mut attempt: F,
+) -> Result<bool>
+where
+    F: FnMut(ClipboardRoute, &str) -> Result<Option<bool>>,
+{
+    for route in routes {
+        if let Some(via_terminal) = attempt(*route, text)? {
+            return Ok(via_terminal);
+        }
+    }
+    Err(TuicrError::Clipboard(
+        "No clipboard route succeeded".to_string(),
+    ))
+}
+
+fn windows_clipboard_bytes(text: &str) -> Vec<u8> {
+    text.encode_utf16()
+        .flat_map(|unit| unit.to_le_bytes())
+        .collect()
+}
